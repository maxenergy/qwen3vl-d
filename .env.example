# Application
APP_NAME="Auto Annotation Tool"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development"

# Server
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/auto_annotation"
DB_ECHO=False

# Redis
REDIS_URL="redis://localhost:6379/0"

# Celery
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Qwen3-VL API
QWEN3VL_API_URL="http://192.168.8.147:9292/v1"
QWEN3VL_MODEL="qwen3-vl-30b"
QWEN3VL_API_KEY=""

# Hunyuan Image 3.0
HUNYUAN_MODEL_PATH="models/hunyuan"
HUNYUAN_API_URL=""  # 如果使用API调用
HUNYUAN_API_KEY=""

# File Storage
DATA_DIR="data"
MODELS_DIR="models"
UPLOAD_MAX_SIZE_MB=100

# Security
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

# YOLO Training
DEFAULT_DEVICE="0"  # GPU ID or "cpu"
DEFAULT_BATCH_SIZE=16
DEFAULT_EPOCHS=100

# TensorBoard
TENSORBOARD_PORT=6006

# Gradio
GRADIO_PORT=7860
GRADIO_SHARE=False
